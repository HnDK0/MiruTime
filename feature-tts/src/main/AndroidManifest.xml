<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Optional floating TTS player over other apps; requested at runtime. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ package visibility: without this query TextToSpeech.getEngines()
         only returns the engine the app already bound to, hiding RHVoice and every
         other installed synthesizer from the voice picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>
        <service
            android:name="dev.mirutime.feature.tts.service.TtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />

        <!-- Headset/Bluetooth media buttons. The system delivers
             ACTION_MEDIA_BUTTON here; the receiver forwards it to the live
             TtsController session (FR-044). -->
        <receiver
            android:name="dev.mirutime.feature.tts.service.TtsMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Notification deleteIntent. Explicit PendingIntent from our app;
             never exported. -->
        <receiver
            android:name="dev.mirutime.feature.tts.service.TtsDismissReceiver"
            android:exported="false" />
    </application>
</manifest>
