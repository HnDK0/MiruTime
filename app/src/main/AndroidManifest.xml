<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+ gates private-network addresses (local LLM servers) behind
    a runtime grant; the settings screen asks when the endpoint is local. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Shared-storage file paths typed as custom backgrounds (API-gated;
    SAF content URIs need no permission). Runtime grant is requested by the
    system on first read attempt outside app-private dirs. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery opt-out actions are resolved before launch on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
    </queries>
    <!-- Settings → Network: real system opt-out dialog, never a local flag. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".MiruApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Video is a separate activity: configChanges keeps playback alive
        across the fullscreen orientation toggle; singleTask is the one-player
        rule (a new episode re-delivers the intent instead of stacking). -->
        <activity
            android:name=".features.video.VideoPlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".features.network.cf.CfChallengeActivity"
            android:exported="false"
            android:label="@string/cf_challenge_title"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" />

        <activity
            android:name=".features.network.cf.CfSolveActivity"
            android:exported="false"
            android:label="@string/cf_challenge_title"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden" />

        <service
            android:name=".features.settings.backup.BackupOperationService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- Untrusted PDF parsing: no permissions, no network, no app files.
        Only duplicated file descriptors cross the boundary. -->
        <service
            android:name=".pdf.PdfRenderService"
            android:exported="false"
            android:isolatedProcess="true" />

        <!-- Offline video: media3 DownloadManager runs in a dataSync FGS. -->
        <service
            android:name=".features.video.VideoDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".features.video.data.VideoDownloadActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".features.downloads.data.DownloadActionReceiver"
            android:exported="false" />

        <!-- WorkManager's foreground executor needs the same type as our
        dataSync worker; merge keeps its other manifest attributes. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
