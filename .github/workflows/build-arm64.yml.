name: Build arm64-v8a Debug APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - uses: gradle/actions/setup-gradle@v4
      - name: Run TTS tests & build arm64-v8a APK
        run: |
          chmod +x gradlew
          ./gradlew --no-daemon :feature-tts:testDebugUnitTest :app:assembleDebug
      - name: Upload arm64-v8a APK
        uses: actions/upload-artifact@v4
        with:
          name: mirutime-arm64-v8a-debug
          path: app/build/outputs/apk/debug/*arm64-v8a*.apk
